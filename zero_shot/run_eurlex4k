#!/usr/bin/env bash
#SBATCH --job-name=eurlex4k
#SBATCH --output=output.%A_%a.txt
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=64G
#SBATCH --cpus-per-task=128
#SBATCH --partition=cscc-cpu-p
#SBATCH --time=1:00:00
#SBATCH --qos=cscc-cpu-qos

set -euo pipefail

readonly SCRIPT_DIRECTORY="/home/linh.vu/LibMultiLabel/zero_shot"
readonly SCRIPT_DIRECTORY
cd "$SCRIPT_DIRECTORY"

# Experiment configuration
readonly MODEL_PATH="/nfs-stor/linh.vu/runs/eurlex4k_zs_pecos_tree_20260903133623/linear_pipeline.pickle"
readonly DATA_ROOT="/nfs-stor/linh.vu/EURLEX-4K/zeroshot"
readonly DATASET_NAME="eurlex4k"
readonly STRATEGY="rank_rrf"  # raw, rank_rrf, or rank_normal
readonly RUN_NAME="eurlex4k_zs_${STRATEGY}"
readonly PROPENSITY_A="0.55"
readonly PROPENSITY_B="1.5"

# Input files
readonly TRAIN_INSTANCE_DATA_PATH="${DATA_ROOT}/${DATASET_NAME}_tfidf_train_ext_pecos.svm"
readonly TEST_INSTANCE_DATA_PATH="${DATA_ROOT}/${DATASET_NAME}_tfidf_test_ext_pecos.svm"
readonly LABEL_FEATURE_PATH="${DATA_ROOT}/${DATASET_NAME}_tfidf_lf_pecos.svm"

case "$STRATEGY" in
    raw | rank_rrf | rank_normal) ;;
    *)
        echo "Invalid strategy: $STRATEGY" >&2
        exit 1
        ;;
esac

for input_file in \
    "$MODEL_PATH" \
    "$TRAIN_INSTANCE_DATA_PATH" \
    "$TEST_INSTANCE_DATA_PATH" \
    "$LABEL_FEATURE_PATH"; do
    if [[ ! -f "$input_file" ]]; then
        echo "Missing input file: $input_file" >&2
        exit 1
    fi
done

hostname
echo "Run name: $RUN_NAME"
echo "Strategy: $STRATEGY"
echo "PSP propensity: A=$PROPENSITY_A, B=$PROPENSITY_B"

python3 model_predict.py \
    --model_path "$MODEL_PATH" \
    --train_instance_data_path "$TRAIN_INSTANCE_DATA_PATH" \
    --test_instance_data_path "$TEST_INSTANCE_DATA_PATH" \
    --label_feature_path "$LABEL_FEATURE_PATH" \
    --run_name "$RUN_NAME" \
    --strategy "$STRATEGY" \
    --propensity_a "$PROPENSITY_A" \
    --propensity_b "$PROPENSITY_B"
